    {
      "id": 3,
      "type": "table",
      "title": "Processus du dernier relevé : requêtes en cours, bloqués et bloqueurs",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "meteo-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "meteo-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT p.spid AS \"spid\", p.login AS \"Login\", p.hostname AS \"Hôte\", p.programme AS \"Programme\", p.hostprocess AS \"Process hôte\",\n       p.cmd AS \"Commande\", p.statut AS \"Statut\", p.bloqueur_spid AS \"Bloqué par\", p.blocage_s AS \"Blocage (s)\",\n       p.execution_s AS \"Requête (s)\"\nFROM meteo.processus p\nWHERE p.mesure_id = (SELECT dm.mesure_id FROM meteo.derniere_mesure dm JOIN meteo.instance i USING (instance_id)\n                     WHERE i.nom = '$instance')\nORDER BY p.blocage_s DESC NULLS LAST, p.execution_s DESC NULLS LAST, p.spid"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
